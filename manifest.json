{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "./index.html",
  "name": "FiLiGRA - Watermark & Transcode Studio",
  "short_name": "FiLiGRA",
  "description": "Studio client-side d'incrustation de filigrane et d'encodage vidéo MP4 H.264 propulsé par WebAssembly.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "window-controls-overlay"],
  "background_color": "#071018",
  "theme_color": "#071018",
  "orientation": "any",
  "lang": "fr",
  "dir": "ltr",
  "icons": [
    {
      "src": "ico.png",
      "sizes": "200x200",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "ico.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "ico.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": ["video", "utilities", "multimedia", "productivity"]
}

